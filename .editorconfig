root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,vue}]
indent_size = 2

[*.{css,scss}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.blade.php]
indent_style = space
indent_size = 4

[*.{json,json5}]
indent_style = space
indent_size = 2