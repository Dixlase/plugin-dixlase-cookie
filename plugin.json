            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "ja": "独自テーブル plg_dixlase_cookie_consents（訪問者ごとの同意状態を 1 行で保持）と plg_dixlase_cookie_settings（バナー設定）を使用（database.own_tables）。同意バナーをフロントの HTML レスポンスに注入するため InjectCookieConsentBanner ミドルウェアを web グループに登録（system.register_middleware）。古いポリシーバージョンの放棄行を整理する artisan コマンド dls:cookie:prune を登録（system.register_commands）。コアの App\\Contracts\\Cookie\\ConsentStateProviderInterface を実装し、他プラグインが同意状態を参照できるようにする。",
            "en": "Uses own tables plg_dixlase_cookie_consents (one row per visitor holding current consent state) and plg_dixlase_cookie_settings (banner settings) (database.own_tables). Registers the InjectCookieConsentBanner middleware on the web group to inject the consent banner into front-end HTML responses (system.register_middleware). Registers the artisan command dls:cookie:prune to prune abandoned out-of-date rows (system.register_commands). Implements Core's App\\Contracts\\Cookie\\ConsentStateProviderInterface so other plugins can read consent state."
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [],
            "admin": [],
            "front": []
        },
        "contracts": [],
        "migrations": true,
        "commands": true,
        "middleware": true
    },
    "deploy": {
        "_notes": {
            "en": "Runtime-data protection surface consumed by DixlaseDeploy (and any other deploy tool that resolves App\\Contracts\\PluginIntegration\\DeployProtectionRegistryInterface). plg_dixlase_cookie_consents stores per-visitor opt-in / opt-out records — the primary source of the cookie consent audit trail on the visited environment. Overwriting them from a dev sync would destroy legally-required evidence of consent (mirrors the reasoning behind DixlaseLegal's protection of its own consent table). plg_dixlase_cookie_settings is banner text / category configuration that the operator edits in dev and pushes to prod, so it is NOT protected.",
            "ja": "DixlaseDeploy (および App\\Contracts\\PluginIntegration\\DeployProtectionRegistryInterface を解決する任意のデプロイツール) が参照するランタイムデータ保護対象。plg_dixlase_cookie_consents は訪問者ごとのオプトイン / オプトアウト記録で、訪問した環境における cookie 同意監査証跡の一次ソース。dev からの同期で上書きすれば法的に必要な同意証跡が消滅する (DixlaseLegal 側の同意テーブル保護と同じ理由)。plg_dixlase_cookie_settings はバナーテキスト / カテゴリ設定で運用者が dev で編集して prod に push するため保護対象**外**。"
        },
        "protected_tables": [
            "dls_plg_dixlase_cookie_consents"
        ],
        "protected_storage_paths": []
    },
